-- Shallow merge so a saved config from an older version still has every key.
local function withDefaults(saved, defaults)
    local out = {}
    for k, v in pairs(defaults) do
        if type(saved) == "table" and saved[k] ~= nil then out[k] = saved[k] else out[k] = v end
    end
    if type(saved) == "table" then
        for k, v in pairs(saved) do
            if out[k] == nil then out[k] = v end
        end
    end
    return out
end

