local function formatLine(typeName, count)
    local col = COLORS[typeName] or DEFAULT_COLOR
    return string.format("<font color='rgb(%d,%d,%d)'>%s  x%d</font>",
        math.floor(col.R * 255), math.floor(col.G * 255), math.floor(col.B * 255),
        DISPLAY[typeName] or typeName, count)
end

local function applyHUDPosition()
    if not hudContainer then return end

    local pos = config.hud.position or "top-right"
    local anchorX, anchorY, px, py, pxOff, pyOff

    if pos == "bottom-right" then
        anchorX, anchorY, px, py, pxOff, pyOff = 1, 1, 1, 1, -10, -10
    elseif pos == "top-left" then
        anchorX, anchorY, px, py, pxOff, pyOff = 0, 0, 0, 0, 10, 10
    elseif pos == "bottom-left" then
        anchorX, anchorY, px, py, pxOff, pyOff = 0, 1, 0, 1, 10, -10
    else -- top-right (default): keep the v2.4 vertical position
        anchorX, anchorY, px, py, pxOff, pyOff = 1, 0, 1, 0, -10, 0
        py = config.hud.yPosition or 0.86
    end

    hudContainer.AnchorPoint = Vector2.new(anchorX, anchorY)
    hudContainer.Position = UDim2.new(px, pxOff, py, pyOff)
    if hudLabel then
        -- Text runs away from the anchored edge instead of always to the right.
        hudLabel.TextXAlignment = anchorX == 1 and Enum.TextXAlignment.Right
            or Enum.TextXAlignment.Left
    end
end

local function scheduleHUDHide(delay)
    if hudHideTask then pcall(task.cancel, hudHideTask) end
    hudHideTask = nil
    if hudFadeTween then pcall(function() hudFadeTween:Cancel() end) end
    hudFadeTween = nil

    -- Capture the instance: if initHUD runs while this is pending, the stale
    -- callback must not hide the freshly created background.
    local bg = hudBackground
    hudHideTask = task.delay(delay, function()
        if not hudShown or bg ~= hudBackground or not hudGui or not hudGui.Parent then return end
        local tween = TweenService:Create(bg,
            TweenInfo.new(config.hud.fadeDuration, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
            { BackgroundTransparency = 1 })
        hudFadeTween = tween
        tween:Play()
        tween.Completed:Once(function()
            if bg ~= hudBackground then return end
            hudShown = false
            bg.Visible = false
            hudFadeTween = nil
        end)
    end)
end

local function showHUD(counts)
    if not config.hud.enabled then return end
    if not hudGui or not hudGui.Parent then
        local ok = pcall(initHUD)
        if not ok or not hudGui then return end
    end

    applyHUDPosition()

    local total = 0
    local lines = { "<b><font size='12'>KILLAURA</font></b>" }
    for _, typeName in ipairs(ORDERED_TYPES) do
        local cnt = counts[typeName]
        if cnt and cnt > 0 then
            total = total + cnt
            lines[#lines + 1] = formatLine(typeName, cnt)
        end
    end
    for typeName, cnt in pairs(counts) do
        if not orderedSet[typeName] and cnt > 0 then
            total = total + cnt
            lines[#lines + 1] = formatLine(typeName, cnt)
        end
    end
    lines[#lines + 1] = string.format("<b><font size='13'>Total: %d hit%s</font></b>",
        total, total == 1 and "" or "s")
    hudLabel.Text = table.concat(lines, "\n")

    local camera = currentCamera()
    local viewportSize = camera and camera.ViewportSize or Vector2.new(1280, 720)
    local textWidth = 0
    local ok, size = pcall(function()
        return TextService:GetTextSize(hudLabel.Text:gsub("<[^>]+>", ""), 14,
            Enum.Font.GothamMedium, Vector2.new(4096, 4096))
    end)
    if ok and size then textWidth = size.X end

    local containerWidth = math.clamp((textWidth + 24) / viewportSize.X,
        config.hud.minWidth, config.hud.maxWidth)
    hudContainer.Size = UDim2.new(containerWidth, 0, 0, 0)

    if hudFadeTween then pcall(function() hudFadeTween:Cancel() end) end
    hudFadeTween = nil
    hudShown = true
    hudBackground.Visible = true
    hudBackground.BackgroundTransparency = 0.2

    scheduleHUDHide(config.hud.holdDuration)
end

