-- Teardown. Bump the generation first: every loop from a previous execution
-- exits on its next tick instead of being closed mid-wait.
-- ============================================================================
getgenv()._dvnGen = (getgenv()._dvnGen or 0) + 1
local GENERATION = getgenv()._dvnGen
local function alive() return getgenv()._dvnGen == GENERATION end

do
    local conns = {
        "_heartbeatConn", "_inputBeganConn", "_inputEndedConn",
        "_wsChildAddedConn", "_wsChildRemovedConn", "_promptConn",
    }
    for _, key in ipairs(conns) do
        local c = getgenv()[key]
        if c then pcall(function() c:Disconnect() end) end
        getgenv()[key] = nil
    end
    for _, key in ipairs({ "_hudGui", "_mobileGui", "_statusGui" }) do
        local g = getgenv()[key]
        if g then pcall(function() g:Destroy() end) end
        getgenv()[key] = nil
    end
    getgenv()._pdcLoopRunning = false
    getgenv()._mercyMouseLoopRunning = false
    getgenv()._bolterLoopRunning = false
    getgenv()._autoVoteLoopRunning = false
    getgenv()._semiDown = false
    getgenv()._qDown = false

    -- The previous execution may still own a __namecall hook. Restore it, or
    -- every re-exec stacks another hook on top and the chain never unwinds.
    local prevCleanup = getgenv()._cleanupMultiplier
    if type(prevCleanup) == "function" then pcall(prevCleanup) end
    getgenv()._cleanupMultiplier = nil
    _G.multiplier = false
end

-- Load external libraries. These are unpinned third-party URLs, so download,
-- compile and first run are guarded: a bad response now names the source
-- instead of dying with "attempt to call a nil value" before any UI exists.
local function loadRemote(url, label)
    local ok, body = pcall(function() return game:HttpGet(url) end)
    if not ok or type(body) ~= "string" or #body < 64 then
        error(string.format("[dvn] %s: download failed (%s)", label, tostring(body)), 0)
    end
    local chunk, err = loadstring(body, label)
    if not chunk then
        error(string.format("[dvn] %s: compile failed (%s)", label, tostring(err)), 0)
    end
    local ran, result = pcall(chunk)
    if not ran then
        error(string.format("[dvn] %s: runtime error (%s)", label, tostring(result)), 0)
    end
    return result
end

