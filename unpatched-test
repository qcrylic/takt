local function isHoldingTool()
    local character = LocalPlayer.Character
    return character ~= nil and character:FindFirstChildOfClass("Tool") ~= nil
end

local function inCharacter(tool)
    local character = LocalPlayer.Character
    return character ~= nil and tool ~= nil and tool.Parent == character
end

local function equipTool(tool)
    if not tool then return false end
    if inCharacter(tool) then return true end
    local character = LocalPlayer.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    if not humanoid then return false end
    return pcall(function() humanoid:EquipTool(tool) end)
end

-- Raycast for mouse position
local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude
rayParams.IgnoreWater = true

local function getMouseWorldPosition()
    local camera = currentCamera()
    if not camera then return nil end
    local mouseLocation = UserInputService:GetMouseLocation()
    local ok, ray = pcall(function() return camera:ViewportPointToRay(mouseLocation.X, mouseLocation.Y) end)
    if not ok then return nil end
    local filter = {}
    if LocalPlayer.Character then filter[#filter + 1] = LocalPlayer.Character end
    rayParams.FilterDescendantsInstances = filter
    local hit = workspace:Raycast(camera.CFrame.Position, ray.Direction * 1000, rayParams)
    return hit and hit.Position or nil
end

