    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("ProximityPrompt")
            and (string.find(obj.ObjectText or "", promptName, 1, true)
                or string.find(obj.ActionText or "", promptName, 1, true)) then
