-- ============================================================================
-- Weapon detection
-- ============================================================================
local function isMeleeTool(tool)
    if not tool:IsA("Tool") then return false end
    if not (tool:GetAttribute("Class") == "Melee" or tool.Name == "Shovel") then return false end
    local vh = tool:FindFirstChild("VerifyHit")
    return vh ~= nil and vh:IsA("RemoteEvent")
end

local function findMeleeIn(container)
    if not container then return nil end
    for _, tool in ipairs(container:GetChildren()) do
        if isMeleeTool(tool) then return tool end
    end
    return nil
end

local function refreshWeapon()
    if cachedWeapon and inCharacter(cachedWeapon) then return cachedWeapon end

    cachedWeapon = findMeleeIn(LocalPlayer.Character)
    if cachedWeapon then return cachedWeapon end

    -- Backpack melee: equip it, then attack on a later tick. Firing from the
    -- Backpack is silently rejected by the server. Throttled so the attack loop
    -- cannot spam EquipTool every frame while the swap is in flight.
    local bagged = findMeleeIn(LocalPlayer:FindFirstChild("Backpack"))
    if bagged then
        if os.clock() - lastEquipAttempt >= 0.5 then
            lastEquipAttempt = os.clock()
            equipTool(bagged)
        end
        return nil
    end

    notifyThrottled("Melee weapon not found - equip a shovel or melee tool.", 10)
    return nil
end

-- ============================================================================
-- Attack interval calculation
-- ============================================================================
local function calculateAttackInterval(targetCount)
    local t = CONFIG.tuning
    if targetCount == 0 then return t.rescanInterval end
    if targetCount <= t.lowTargetThreshold then return t.attackMinDelay end
    if targetCount >= t.highTargetThreshold then return t.attackBaseDelay end
    return t.attackMinDelay + (t.attackBaseDelay - t.attackMinDelay)
        * ((targetCount - t.lowTargetThreshold) / (t.highTargetThreshold - t.lowTargetThreshold))
end

