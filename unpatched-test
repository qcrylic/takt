-- `default` mirrors a flag restored from getgenv; without it a re-exec ran a
-- feature while its switch still read off.
local function toggle(tab, name, title, cb, default)
    local element = tab:AddToggle(name, { Title = title, Default = default == true })
    element:OnChanged(cb)
    return element
end

local function setToggleValue(element, value)
    if not element then return end
    local ok = pcall(function() element:SetValue(value) end)
    if not ok then pcall(function() element:Set(value) end) end
end

-- MAIN TAB
-- Each enable gets a fresh run id. Loops exit on their own next tick; closing a
-- thread parked inside task.wait leaves a queued resume behind ("cannot resume
-- dead coroutine") and, worse, a fast off/on could leave two attack loops alive.
local killauraRun = 0

toggle(Tabs.Main, "KillauraToggle", "Killaura", function(v)
    config.killauraEnabled = v
    killauraRun = killauraRun + 1
    local myRun = killauraRun
    setKillauraActive(v)

    if not v then
        npcCache, cachedWeapon = {}, nil
        npcStale = true -- force a rescan so Bring NPCs does not return the emptied cache
        return
    end

    killauraScanThread = coroutine.create(function()
        while alive() and killauraActive and myRun == killauraRun do
            pcall(scanNPCs, true)
            task.wait(CONFIG.tuning.forcedRescanInterval)
        end
    end)
    getgenv()._killauraScanThread = killauraScanThread
    coroutine.resume(killauraScanThread)

    killauraAttackThread = coroutine.create(function()
        while alive() and killauraActive and myRun == killauraRun do
            local fired = 0
            pcall(function()
                -- Cheap when nothing changed: returns the cache unless ChildAdded
                -- or a Died listener marked it stale, so new spawns are picked up
                -- without waiting up to 2s for the forced rescan.
                scanNPCs(false)
                fired = attackBatch(npcCache) or 0
            end)
            task.wait(calculateAttackInterval(fired))
        end
    end)
    getgenv()._killauraAttackThread = killauraAttackThread
    coroutine.resume(killauraAttackThread)
end)

