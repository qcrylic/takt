-- ============================================================================
-- Killaura attack logic
-- ============================================================================
local consecutiveFireFailures = 0
local lastFailurePauseTime = 0

local function attackBatch(targets)
    if #targets == 0 then return 0 end
    -- Equip before checking the hand: with nothing held isHoldingTool() is
    -- false, and returning here made refreshWeapon()'s backpack auto-equip
    -- unreachable, so killaura stayed dead after every respawn.
    local weapon = refreshWeapon()
    if not weapon or not isHoldingTool() then return 0 end

    local verifyHitRemote = weapon:FindFirstChild("VerifyHit")
    if not verifyHitRemote or not verifyHitRemote:IsA("RemoteEvent") or not verifyHitRemote.Parent then
        cachedWeapon = nil
        return 0
    end

    local swingToken = generateSwingToken()
    local counts, fired = {}, 0

    for i = 1, #targets do
        if not killauraActive or not alive() then break end
        local entry = targets[i]
        local hum = entry.target
        if hum.Parent and hum.Health > 0 and entry.model.Parent then
            local success = pcall(function() verifyHitRemote:FireServer(hum, swingToken) end)
            if success then
                consecutiveFireFailures = 0
                local modelName = entry.model.Name
                counts[modelName] = (counts[modelName] or 0) + 1
                fired = fired + 1
            else
                consecutiveFireFailures = consecutiveFireFailures + 1
                if consecutiveFireFailures > 10 and os.clock() - lastFailurePauseTime > 2 then
                    lastFailurePauseTime = os.clock()
                    notifyThrottled("Killaura FireServer failing - pausing attacks for 2s", 10)
                    task.wait(2)
                    consecutiveFireFailures = 0
                end
            end
        end
    end

    if next(counts) then pcall(showHUD, counts) end
    return fired
end

-- ============================================================================
-- Damage multiplier hook
-- ============================================================================
local function resetBurstState()
    currentTargetHumanoid, targetLocked, isBursting = nil, false, false
end

local function jitterVector(v)
    local s = 0.01
    return v + Vector3.new(
        math.random() * s - s / 2,
        math.random() * s - s / 2,
        math.random() * s - s / 2
    )
end

local function cleanupMultiplier()
    resetBurstState()
    if not metatableModified then return end
    pcall(function()
        setreadonly(gameMetatable, false)
        if gameMetatable.__namecall == savedHook then
            gameMetatable.__namecall = originalNamecall
        end
        setreadonly(gameMetatable, true)
    end)
    metatableModified = false
end

-- Published so a later execution can unwind this hook before installing its own.
getgenv()._cleanupMultiplier = cleanupMultiplier

local function setupMultiplier()
    cleanupMultiplier()

    local newcclosureFn = newcclosure or function(f) return f end
    local raw
    local ok = pcall(function()
        if type(getrawmetatable) ~= "function" then error("no getrawmetatable") end
        if type(setreadonly) ~= "function" then error("no setreadonly") end
        if type(getnamecallmethod) ~= "function" then error("no getnamecallmethod") end

        raw = getrawmetatable(game)
        if not raw then error("no metatable") end
        setreadonly(raw, false)
        originalNamecall = raw.__namecall
        if type(originalNamecall) ~= "function" then error("no __namecall") end

        savedHook = newcclosureFn(function(self, ...)
            local method = getnamecallmethod()
            if _G.multiplier and method == "FireServer"
                and self.Name == "VerifyHit" and self:IsA("RemoteEvent")
                and LocalPlayer.Character and self:IsDescendantOf(LocalPlayer.Character) then

                local args = table.pack(...)
                local targetHumanoid = args[1]
                if typeof(targetHumanoid) == "Instance" and targetHumanoid:IsA("Humanoid")
                    and (not isBursting or currentTargetHumanoid ~= targetHumanoid) then

                    currentTargetHumanoid, targetLocked, isBursting = targetHumanoid, true, true
                    local remote, packed = self, args

                    task.spawn(function()
                        local iteration = 1
                        while targetLocked and currentTargetHumanoid == targetHumanoid
                            and metatableModified and alive() do
                            if not remote:IsDescendantOf(LocalPlayer.Character)
                                or not targetHumanoid.Parent or targetHumanoid.Health <= 0 then
                                if currentTargetHumanoid == targetHumanoid then resetBurstState() end
                                break
                            end
                            iteration = iteration + 1
                            pcall(function()
                                local out = table.pack(table.unpack(packed, 1, packed.n))
                                for i = 1, out.n do
                                    if typeof(out[i]) == "Vector3" then
                                        out[i] = jitterVector(out[i])
                                    end
                                end
                                remote.FireServer(remote, table.unpack(out, 1, out.n))
                            end)
                            if iteration > CONFIG.tuning.burstCap then
                                if currentTargetHumanoid == targetHumanoid then resetBurstState() end
                                break
                            end
                            task.wait(CONFIG.tuning.burstDelay)
                        end
                    end)
                end
            end
            return originalNamecall(self, ...)
        end)

        raw.__namecall = savedHook
        setreadonly(raw, true)
        gameMetatable = raw
        metatableModified = true
    end)

    if not ok then
        pcall(function() if raw then setreadonly(raw, true) end end)
        gameMetatable, originalNamecall, savedHook = nil, nil, nil
        metatableModified = false
        _G.multiplier = false
        notify("Damage Multiplier", "Executor lacks metatable access - disabled", 5)
    end
end

