-- ============================================================================
-- NPC Cache helpers
-- ============================================================================
local function cacheAddTarget(staging, model, humanoid)
    if not humanoid then return false end
    if not diedHooked[humanoid] then
        diedHooked[humanoid] = true
        humanoid.Died:Once(function() npcStale = true end)
    end
    staging[#staging + 1] = { model = model, target = humanoid }
    return true
end

local function scanModelChildren(staging, parent, model, pattern)
    local foundAny = false
    for _, child in ipairs(parent:GetChildren()) do
        if child:IsA("Model") and string.match(child.Name, pattern)
            and cacheAddTarget(staging, model, getLiveHumanoid(child)) then
            foundAny = true
        end
    end
    return foundAny
end

local function scanNPCs(force)
    if not force and not npcStale then return npcCache end

    local staging = useBufA and npcBufB or npcBufA
    table.clear(staging)
    local children = workspace:GetChildren()

    -- Hermes can be a direct child or one folder deep; the old code used a full
    -- GetDescendants every scan. Two levels covers both without the cost.
    local function handleHermes(model)
        if not scanModelChildren(staging, model, model, "^Launcher%d+$") then
            cacheAddTarget(staging, model, getLiveHumanoid(model))
        end
    end

    for _, model in ipairs(children) do
        if model:IsA("Model") and model.Name == "Hermes" then
            handleHermes(model)
        elseif model:IsA("Folder") then
            for _, inner in ipairs(model:GetChildren()) do
                if inner:IsA("Model") and inner.Name == "Hermes" then
                    handleHermes(inner)
                end
            end
        end
    end

    for _, model in ipairs(children) do
        if not model:IsA("Model") then continue end
        if model.Name == "Hermes" then continue end
        if PlayersService:GetPlayerFromCharacter(model) then continue end

        local name = model.Name

        if name == "Drone" then
            cacheAddTarget(staging, model, getLiveHumanoid(model))
        elseif EXCLUDED[name] then
            continue
        elseif name ~= "Model" and name ~= "Folder" then
            if name == "Platform" then
                local found = false
                for _, child in ipairs(model:GetDescendants()) do
                    if child:IsA("Model") and string.match(child.Name, "^Emplacement%d+$") then
                        if cacheAddTarget(staging, model, getLiveHumanoid(child)) then found = true end
                    end
                end
                if not found then cacheAddTarget(staging, model, getLiveHumanoid(model)) end
            elseif name == "Tank" then
                if not scanModelChildren(staging, model, model, "^PropaneTank$") then
                    cacheAddTarget(staging, model, getLiveHumanoid(model))
                end
            elseif name == "APU" then
                -- getLiveHumanoid(nil) throws, and that aborted the whole scan,
                -- so an APU without a Pilot used to stop all targeting.
                local pilot = model:FindFirstChild("Pilot")
                cacheAddTarget(staging, model, (pilot and getLiveHumanoid(pilot)) or getLiveHumanoid(model))
            else
                cacheAddTarget(staging, model, getLiveHumanoid(model))
            end
        end
    end

    npcCache = staging
    useBufA = not useBufA
    npcStale = false

    if _G.killauraDebug then
        local names = {}
        for _, e in ipairs(staging) do names[#names + 1] = e.model.Name end
        print("[killaura] cache (" .. #staging .. "): " .. table.concat(names, ", "))
    end
    return npcCache
end

