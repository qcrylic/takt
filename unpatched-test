    while alive() do
        if config.isAutoVoteEnabled then
            local vote = lib.remote({ "Remotes", "Waves", "Vote" })
            if vote then
                -- The remote exists for the whole session, so the old retry loop
                -- invoked it about once a second forever. Space out the calls.
                pcall(function() vote:InvokeServer() end)
                task.wait(CONFIG.tuning.voteCooldown)
            else
                task.wait(1)
            end
        else
            task.wait(1)
        end
    end
    getgenv()._autoVoteLoopRunning = false
end)

