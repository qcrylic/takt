local lib = {}

lib.hrp      = getLocalPlayerHRP
lib.mousePos = getMouseWorldPosition
lib.npcs     = function(force) return scanNPCs(force or false) end

lib.findTool = function(name)
    local character = LocalPlayer.Character
    if character then
        local t = character:FindFirstChild(name)
        if t then return t end
    end
    local bp = LocalPlayer:FindFirstChild("Backpack")
    return bp and bp:FindFirstChild(name)
end

lib.playerModelChild = function(name)
    local pm = workspace:FindFirstChild(LocalPlayer.Name)
    return pm and pm:FindFirstChild(name)
end

-- pcall(r.FireServer, r, ...) preserves varargs and nils (e.g. FireServer(nil, pos)).
lib.fire = function(container, remoteName, ...)
    if not container then return false end
    local r = container:FindFirstChild(remoteName)
    if not r or not r:IsA("RemoteEvent") then return false end
    return pcall(r.FireServer, r, ...)
end

-- A tool in the Backpack cannot fire; equip it and fire on the next frame.
lib.fireTool = function(toolName, remoteName, ...)
    local tool = lib.findTool(toolName)
    if not tool then return false end
    if inCharacter(tool) then
        return lib.fire(tool, remoteName, ...)
    end
    if not equipTool(tool) then return false end
    local packed = table.pack(...)
    task.spawn(function()
        task.wait()
        if inCharacter(tool) then
            local r = tool:FindFirstChild(remoteName)
            if r and r:IsA("RemoteEvent") then
                pcall(r.FireServer, r, table.unpack(packed, 1, packed.n))
            end
        end
    end)
    return true
end

lib.firePlayerModel = function(childName, remoteName, ...)
    return lib.fire(lib.playerModelChild(childName), remoteName, ...)
end

lib.remote = function(path)
    local node = game:GetService("ReplicatedStorage")
    for _, seg in ipairs(path) do node = node and node:FindFirstChild(seg) end
    return node
end

lib.destroyNamed = function(name)
    local any
    for _, obj in ipairs(workspace:GetChildren()) do
        if obj.Name == name then
            pcall(function() obj:Destroy() end)
            any = true
        end
    end
    return any
end

-- ============================================================================
-- Teleport NPCs
-- ============================================================================
local function bringNPCs()
    local hrp = lib.hrp()
    if not hrp then return end
    local forward = hrp.CFrame.LookVector
    local yaw = hrp.Orientation.Y
    for _, entry in ipairs(lib.npcs()) do
        if entry.target.Parent and entry.target.Health > 0 and not NOT_TELEPORTABLE[entry.model.Name] then
            local primaryPart = entry.model.PrimaryPart or entry.model:FindFirstChild("HumanoidRootPart")
            if primaryPart then
                local distance = entry.model.Name == "Tank" and CONFIG.tuning.tankDistance or CONFIG.tuning.defaultDistance
                pcall(function()
                    entry.model:PivotTo(CFrame.new(hrp.Position + forward * distance)
                        * CFrame.Angles(0, math.rad(yaw), 0))
                end)
            end
        end
    end
end

